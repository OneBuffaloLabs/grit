# Force strict engine versions (prevents running under incompatible Node/pnpm versions)
engine-strict=true

# Enforce explicit peer dependency resolution (prevents silent runtime bugs)
strict-peer-dependencies=true

# Prevent automatic execution of build scripts from untrusted packages (security)
# enable-pre-post-scripts=false

# Automatically save exact dependency versions in package.json (no ^ or ~)
# save-exact=true

# Auto-install peer dependencies if missing
auto-install-peers=true
